{
  "name": "jewbuntu-jewish-service",
  "private": true,
  "version": "0.1.0",
  "description": "Build-time only: produces vendor/hebcal.bundle.js (ES module) for GJS. Not installed with npm on user machines.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "bundle": "esbuild src/hebcal-entry.js --bundle --format=esm --platform=neutral --target=es2022 --legal-comments=eof --outfile=vendor/hebcal.bundle.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@hebcal/core": "6.16.0"
  },
  "devDependencies": {
    "esbuild": "0.27.2"
  }
}
