# Debian 13 (trixie) with Cutefish Desktop from Cutefish's own APT repository, for testing the
# Jewbuntu Cutefish packages. Builds natively on arm64; pass --platform linux/amd64 for amd64.
FROM debian:trixie
ENV DEBIAN_FRONTEND=noninteractive
COPY cutefish-archive.asc /etc/apt/keyrings/cutefish.asc
RUN for i in 1 2 3; do apt-get update && break; sleep 5; done \
 && apt-get install -y --no-install-recommends ca-certificates \
 && echo 'deb [signed-by=/etc/apt/keyrings/cutefish.asc] https://download.cutefish.org/debian trixie-nightly main' \
      > /etc/apt/sources.list.d/cutefish.list \
 && for i in 1 2 3; do apt-get update && break; sleep 5; done \
 && apt-get install -y --no-install-recommends \
      cutefish-core cutefish-settings cutefish-wallpapers cutefish-compositor \
      dbus dbus-x11 libglib2.0-bin python3 python3-gi gir1.2-gtk-3.0 gir1.2-ayatanaappindicator3-0.1 \
      xvfb xauth procps file ca-certificates pipewire-bin \
 && rm -rf /var/lib/apt/lists/*
