[Unit]
Before=graphical-session-pre.target
Description=Migrate Jewbuntu user settings to the installed schema
Documentation=file:///usr/share/doc/jewbuntu-core/README.md
# Runs as the logged-in user, never as root. Safe to run repeatedly.
# Exits immediately when no settings file exists yet.

[Service]
Type=oneshot
ExecStart=/usr/bin/jewbuntu config migrate --quiet
Nice=10
TimeoutStartSec=30

[Install]
# default.target: when the user manager starts (also headless/node).
# graphical-session-pre.target: every graphical login, even if the user manager
# stayed up (e.g. an SSH session was open) - so an upgrade is never missed.
WantedBy=default.target graphical-session-pre.target
