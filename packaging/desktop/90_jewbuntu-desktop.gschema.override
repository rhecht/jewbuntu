# Jewbuntu desktop defaults (vendor override: changes defaults only;
# users' own changes always win). Keep in sync with desktop-defaults.json.
# Sorted after Ubuntu's 10_ubuntu-* overrides so these defaults apply in the
# Ubuntu session. The plain "GNOME" session ignores :ubuntu sections and stays stock.

[org.gnome.desktop.background:ubuntu]
picture-uri='file:///usr/share/backgrounds/Jewbuntu/Jewbuntu-star-blue.png'
picture-uri-dark='file:///usr/share/backgrounds/Jewbuntu/Jewbuntu-star-purple.png'

[org.gnome.desktop.screensaver:ubuntu]
picture-uri='file:///usr/share/backgrounds/Jewbuntu/Jewbuntu-star-blue.png'

[org.gnome.desktop.interface:ubuntu]
accent-color='blue'
gtk-theme='Jewbuntu-Light'
icon-theme='Jewbuntu'
font-name='Inter 11'
document-font-name='Inter 11'
clock-show-weekday=true

[org.gnome.desktop.wm.preferences:ubuntu]
button-layout='close,minimize,maximize:appmenu'
titlebar-font='Inter Semi-Bold 11'

[org.gnome.mutter:ubuntu]
center-new-windows=true

[org.gnome.desktop.peripherals.touchpad:ubuntu]
tap-to-click=true

# Mac-style dock: floating, compact, rounded (the skin draws the glass), dot indicators,
# always visible (maximised windows stop above it), trash at the end.
[org.gnome.shell.extensions.dash-to-dock:ubuntu]
dock-position='BOTTOM'
extend-height=false
dock-fixed=true
intellihide=true
always-center-icons=true
custom-theme-shrink=true
force-straight-corner=false
running-indicator-style='DOTS'
dash-max-icon-size=56
show-apps-at-top=false
show-trash=true
show-mounts=false
click-action='minimize-or-previews'

# Shell theme from the Jewbuntu Skin (needs the User Themes extension, enabled by 'jewbuntu skin apply').
[org.gnome.shell.extensions.user-theme:ubuntu]
name='Jewbuntu-Light'

# Login screen logo (replaces the Ubuntu logo set by 10_ubuntu-settings; same plain section).
[org.gnome.login-screen]
logo='/usr/share/jewbuntu/branding/jewbuntu-logo-text-dark.svg'

# Blur my Shell: no blur behind the top bar (kept clear by Jewbuntu Look) or the dock
# (its rectangular blur showed as a box around the skin's rounded dock).
[org.gnome.shell.extensions.blur-my-shell.panel]
blur=false

[org.gnome.shell.extensions.blur-my-shell.dash-to-dock]
blur=false

# ...nor behind popups (menus, quick settings, calendar, notifications, dialogs) or open app
# folders: Blur my Shell blurs a fixed-radius or square area that doesn't match the skin's
# rounded shapes, which showed as dark or grey corners. The skin draws their glass itself.
[org.gnome.shell.extensions.blur-my-shell.popup]
blur=false

[org.gnome.shell.extensions.blur-my-shell.appfolder]
blur=false

# Terminal (Ptyxis): the Jewbuntu palette (white or the skin's dark grey, Jewbuntu blue
# cursor, matching title bar and menus) instead of Ubuntu's purple, following the system
# light/dark style. Each user gets the palette file at login (`jewbuntu config migrate`).
[org.gnome.Ptyxis.Profile]
palette='Jewbuntu'

[org.gnome.Ptyxis]
interface-style='system'
