      "key": "picture-uri",
      "value": "'file:///usr/share/backgrounds/jewbuntu/jewbuntu-dawn.svg'",
      "why": "Jewbuntu wallpaper (light)"
    },
    {
      "schema": "org.gnome.desktop.background",
      "key": "picture-uri-dark",
