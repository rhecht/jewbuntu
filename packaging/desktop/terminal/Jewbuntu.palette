[Palette]
Name=Jewbuntu
Primary=true
UseSystemAccent=true

# Matches the Jewbuntu skin: white windows with a white title bar in light mode, the skin's
# greys in dark mode, and Jewbuntu blue for the cursor. ANSI colours follow GNOME's palette.

[Light]
Foreground=#242424
Background=#ffffff
TitlebarBackground=#ffffff
TitlebarForeground=#242424
Cursor=#0088ff
Color0=#242424
Color1=#c01c28
Color2=#26a269
Color3=#a2734c
Color4=#0068c9
Color5=#a347ba
Color6=#2aa1b3
Color7=#cfcfcf
Color8=#5d5d5d
Color9=#f66151
Color10=#33d17a
Color11=#e9ad0c
Color12=#0088ff
Color13=#c061cb
Color14=#33c7de
Color15=#ffffff

[Dark]
Foreground=#dedede
Background=#242424
TitlebarBackground=#333333
TitlebarForeground=#dedede
Cursor=#0088ff
Color0=#1f1f1f
Color1=#ed333b
Color2=#2ec27e
Color3=#f5c211
Color4=#3a9bff
Color5=#c061cb
Color6=#0ab9dc
Color7=#c0bfbc
Color8=#5e5c64
Color9=#f66151
Color10=#57e389
Color11=#f8e45c
Color12=#66b3ff
Color13=#dc8add
Color14=#4fd2fd
Color15=#f6f5f4
