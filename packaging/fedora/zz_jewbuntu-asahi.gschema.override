# Jewbuntu defaults for Fedora Asahi Remix (GNOME edition). Vendor override: changes
# defaults only, so anything a user set stays theirs. Keep in sync with desktop-defaults.json
# here (tests/unit/test_fedora.py checks).
#
# Named zz_ on purpose: glib-compile-schemas lets later file names win, and Fedora's own
# overrides (10_org.gnome.desktop.background.fedora..., gdm's org.gnome.login-screen...)
# sort after any 90_ name. Desktop keys use :GNOME sections, which also outrank plain
# sections from other files; they apply to the GNOME session (and GDM, GNOME-Greeter:GNOME).
# Removing jewbuntu-asahi-desktop removes this file and Fedora's defaults come straight back.

[org.gnome.desktop.background:GNOME]
picture-uri='file:///usr/share/backgrounds/Jewbuntu/Jewbuntu-star-blue.png'
picture-uri-dark='file:///usr/share/backgrounds/Jewbuntu/Jewbuntu-star-purple.png'

[org.gnome.desktop.screensaver:GNOME]
picture-uri='file:///usr/share/backgrounds/Jewbuntu/Jewbuntu-star-blue.png'

[org.gnome.desktop.interface:GNOME]
accent-color='blue'
gtk-theme='Jewbuntu-Light'
icon-theme='Jewbuntu'
font-name='Inter 11'
document-font-name='Inter 11'
clock-show-weekday=true

[org.gnome.desktop.wm.preferences:GNOME]
button-layout='close,minimize,maximize:appmenu'
titlebar-font='Inter Semi-Bold 11'

[org.gnome.mutter:GNOME]
center-new-windows=true

[org.gnome.desktop.peripherals.touchpad:GNOME]
tap-to-click=true

# English and Hebrew keyboards (Super+Space switches). Users who chose layouts keep theirs.
[org.gnome.desktop.input-sources:GNOME]
sources=[('xkb', 'us'), ('xkb', 'il')]

# Mac-style dock (Dash to Dock, enabled per account by 'jewbuntu skin apply'): floating,
# compact, rounded (the skin draws the glass), dot indicators, always visible, trash at the end.
[org.gnome.shell.extensions.dash-to-dock:GNOME]
dock-position='BOTTOM'
extend-height=false
dock-fixed=true
intellihide=true
always-center-icons=true
custom-theme-shrink=true
force-straight-corner=false
running-indicator-style='DOTS'
dash-max-icon-size=56
show-apps-at-top=false
show-trash=true
show-mounts=false
click-action='minimize-or-previews'

# Shell theme from the Jewbuntu Skin (needs User Themes, enabled by 'jewbuntu skin apply').
[org.gnome.shell.extensions.user-theme:GNOME]
name='Jewbuntu-Light'

# Blur my Shell: no blur behind the top bar (kept clear by Jewbuntu Look) or the dock.
[org.gnome.shell.extensions.blur-my-shell.panel:GNOME]
blur=false

[org.gnome.shell.extensions.blur-my-shell.dash-to-dock:GNOME]
blur=false

# ...nor behind popups (menus, quick settings, calendar, notifications, dialogs) or open app
# folders: Blur my Shell blurs a fixed-radius or square area that doesn't match the skin's
# rounded shapes, which showed as dark corners. The skin draws their glass itself.
[org.gnome.shell.extensions.blur-my-shell.popup:GNOME]
blur=false

[org.gnome.shell.extensions.blur-my-shell.appfolder:GNOME]
blur=false

# Overview: keep the blur, but don't let Blur my Shell restyle the app grid. Its "automatic"
# style picks light components on a light wallpaper, turning app labels dark grey, which is
# unreadable on the skin's folder panel. The skin's own label colours apply instead.
[org.gnome.shell.extensions.blur-my-shell.overview:GNOME]
style-components=0

# Terminal (Ptyxis, Fedora's default): the Jewbuntu palette, following the system light/dark
# style. Each user gets the palette file at login (`jewbuntu config migrate`).
[org.gnome.Ptyxis.Profile:GNOME]
palette='Jewbuntu'

[org.gnome.Ptyxis:GNOME]
interface-style='system'

# Fedora's Background Logo extension draws a "fedora" mark on the default wallpaper. The
# Jewbuntu desktop matches Ubuntu's, so the mark is fully transparent; the extension itself
# stays Fedora's and untouched (a default only: remove this package and the mark returns).
[org.gnome.shell.extensions.background-logo:GNOME]
logo-opacity=0

# Login screen: "Jewbuntu for Asahi Linux" wordmark in place of gdm's Fedora logo
# (plain section, like gdm's own override, which this file sorts after).
[org.gnome.login-screen]
logo='/usr/share/jewbuntu/branding/jewbuntu-asahi-logo-text-dark.svg'
