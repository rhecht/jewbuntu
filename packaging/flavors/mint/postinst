#!/bin/sh
set -e
F=/usr/share/cinnamon/applets/menu@cinnamon.org/settings-override.json
gen() {
  [ -f "$F.mint" ] || return 0
  python3 - "$F.mint" "$F.jewbuntu-new" <<'PY'
import json, sys
src, dst = sys.argv[1:3]
d = json.load(open(src))
icon = d.setdefault("menu-icon", {})
icon["default"] = icon["default_icon"] = "jewbuntu-start"
cats = icon.setdefault("icon_categories", [])
if not any(c.get("name") == "Jewbuntu" for c in cats):
    cats.insert(0, {"name": "Jewbuntu", "icons": ["jewbuntu-start", "jewbuntu-start-symbolic"]})
icon["default_category"] = "Jewbuntu"
json.dump(d, open(dst, "w"), indent=4)
PY
  chmod 644 "$F.jewbuntu-new"; mv "$F.jewbuntu-new" "$F"
}
case "$1" in
  configure|triggered)
    gen
    glib-compile-schemas /usr/share/glib-2.0/schemas || true
    gtk-update-icon-cache -q -f /usr/share/icons/hicolor 2>/dev/null || true ;;
esac
exit 0
