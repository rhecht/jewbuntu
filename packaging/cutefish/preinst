#!/bin/sh
# Jewbuntu replaces Cutefish's Launchpad ("start") button picture in the dock with a Star of David.
# dpkg-divert moves Cutefish's own file aside (it keeps being updated there, under
# launchpad.svg.cutefish), so Cutefish updates never overwrite the Jewbuntu one, and removing this
# package puts Cutefish's back.
set -e
if [ "$1" = install ] || [ "$1" = upgrade ]; then
  dpkg-divert --package jewbuntu-cutefish --add --rename \
    --divert /usr/share/cutefish-compositor/shell/launchpad.svg.cutefish \
    /usr/share/cutefish-compositor/shell/launchpad.svg
fi
exit 0
