  <property name="color-cursor-use-default" type="bool" value="false"/>
  <property name="color-cursor" type="string" value="#0088ff"/>
  <property name="color-bold-use-default" type="bool" value="true"/>
  <property name="color-palette" type="string" value="#242424;#c01c28;#26a269;#a2734c;#0068c9;#a347ba;#2aa1b3;#cfcfcf;#5d5d5d;#f66151;#33d17a;#e9ad0c;#0088ff;#c061cb;#33c7de;#ffffff"/>
